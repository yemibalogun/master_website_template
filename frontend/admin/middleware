import { NextRequest, NextResponse } from "next/server"

/**
 * Admin routes that are allowed without auth / tenant.
 * These must NEVER redirect, or loops occur.
 */
const PUBLIC_ADMIN_PATHS: string[] = [
  "/admin/login",
  "/admin/select-tenant",
]

/**
 * Safely read cookies in Edge runtime.
 */
function getCookie(
  request: NextRequest,
  name: string
): string | null {
  try {
    return request.cookies.get(name)?.value ?? null
  } catch {
    return null
  }
}

/**
 * Check if a path is explicitly public.
 */
function isPublicAdminPath(pathname: string): boolean {
  return PUBLIC_ADMIN_PATHS.some((path) =>
    pathname.startsWith(path)
  )
}

export function middleware(request: NextRequest) {
  const { pathname } = request.nextUrl

  /**
   * 0️⃣ Only guard admin routes
   */
  if (!pathname.startsWith("/admin")) {
    return NextResponse.next()
  }

  /**
   * 1️⃣ Allow public admin routes unconditionally
   * CRITICAL: must come before any auth / tenant checks
   */
  if (isPublicAdminPath(pathname)) {
    return NextResponse.next()
  }

  const accessToken: string | null = getCookie(request, "access_token")
  const tenantId: string | null = getCookie(request, "tenant_id")

  /**
   * 2️⃣ Enforce authentication
   */
  if (!accessToken) {
    const loginUrl = request.nextUrl.clone()
    loginUrl.pathname = "/admin/login"
    loginUrl.searchParams.set("next", pathname)

    return NextResponse.redirect(loginUrl)
  }

  /**
   * 3️⃣ Enforce tenant selection
   * Middleware only checks existence — NOT validity
   */
  if (!tenantId) {
    const tenantUrl = request.nextUrl.clone()
    tenantUrl.pathname = "/admin/select-tenant"

    return NextResponse.redirect(tenantUrl)
  }

  /**
   * 4️⃣ All invariants satisfied → allow navigation
   */
  return NextResponse.next()
}

/**
 * Explicit matcher to avoid accidental execution
 */
export const config = {
  matcher: ["/admin/:path*"],
}
